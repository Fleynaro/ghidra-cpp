{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": [
        "bridge-mcp-ghidra"
      ],
      "enabled": true
    },
    "vscode": {
      "type": "remote",
      "url": "http://localhost:3000/mcp",
      "enabled": false
    }
  },
  "indexing": {
    "provider": "ollama",
    "model": "qwen3-embedding:4b",
    "dimension": 1536,
    "enabled": true,
    "fileExtensions": [
      ".c",
      ".cc",
      ".cpp",
      ".cppm",
      ".h",
      ".hh",
      ".html",
      ".md",
      ".py"
    ],
    "embeddingBatchSize": 100
  }
}