{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": [
        "bridge-mcp-ghidra"
      ],
      "enabled": true
    }
  },
  "indexing": {
    "provider": "ollama",
    "model": "qwen3-embedding:4b",
    "dimension": 1536,
    "enabled": true,
    "fileExtensions": [
      ".bat",
      ".c",
      ".cc",
      ".cpp",
      ".cspec",
      ".g",
      ".gradle",
      ".h",
      ".hpp",
      ".java",
      ".ldefs",
      ".md",
      ".opinion",
      ".pspec",
      ".py",
      ".sh",
      ".sinc",
      ".slaspec",
      ".xml"
    ]
  },
}