#include <winres.h>
#include "resource.h"

LANGUAGE 9, 1

STRINGTABLE
BEGIN
    IDS_GREETING "Resource reference greeting"
    IDS_SECOND "Resource reference second string"
END

IDD_FIXTURE_DIALOG DIALOGEX 0, 0, 120, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resource Fixture"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Resource dialog", -1, 8, 8, 100, 12
END

IDR_FIXTURE_MENU MENU
BEGIN
    POPUP "Fixture"
    BEGIN
        MENUITEM "Resource item", 401
    END
END
