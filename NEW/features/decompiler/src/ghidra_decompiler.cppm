            stopNode = (ValueSet*)0;
            isDirty = false;
        } ///< Construct empty partition
    };

    /// \brief A special form of ValueSet associated with the \e read \e point of a Varnode
    ///
    /// When a Varnode is read, it may have a more restricted range at the point of the read
