        SizeRestrictedFilter(const SizeRestrictedFilter& op2); ///< Copy constructor
        bool filterOnSize(Datatype* dt) const;                 ///< Enforce any size bounds on a given data-type
        virtual DatatypeFilter* clone(void) const {
