class Architecture;

extern AttributeId ATTRIB_DYNAMIC;        ///< Marshaling attribute "dynamic"
extern AttributeId ATTRIB_INCIDENTALCOPY; ///< Marshaling attribute "incidentalcopy"
extern AttributeId ATTRIB_INJECT;         ///< Marshaling attribute "inject"
