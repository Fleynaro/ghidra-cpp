        static const string KEYWORD_CASE;        ///< "case" keyword
        static const string KEYWORD_SWITCH;      ///< "switch" keyword
        static const string KEYWORD_DEFAULT;     ///< "default" keyword
        static const string KEYWORD_RETURN;      ///< "return" keyword
